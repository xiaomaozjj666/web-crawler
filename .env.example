# 复制为 .env 并按需填写（.env 已在 .gitignore 中，切勿提交真实密钥）
# DeepSeek OpenAI 兼容接口密钥，由 web_crawler.ai.llm.DeepSeekProvider 读取
DEEPSEEK_API_KEY=<your-key>

# 自定义 OpenAI 兼容 provider 的密钥（OpenAICompatibleProvider 默认读取，可选）
# 例如 LLM_API_KEY=<your-key>
LLM_API_KEY=<your-key>

# 覆盖 Web UI 任务记录 SQLite 数据库路径（app/db.py 读取，默认项目根目录 crawler_data.db）
# 例如 CRAWLER_DB_PATH=/path/to/crawler_data.db
CRAWLER_DB_PATH=/path/to/crawler_data.db
